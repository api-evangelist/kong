{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kong Enterprise Admin ACLs Event Gateway Nodes API",
    "version": "3.14.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Kong-Admin-Token",
      "value": "{{Kong-Admin-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Event Gateway Nodes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Nodes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v1/event-gateways/:gatewayId/nodes",
            "params": [
              {
                "name": "gatewayId",
                "value": "",
                "type": "path",
                "description": "The UUID of your Gateway."
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "The maximum number of items to include per page. The last page of a collection may include fewer items."
              },
              {
                "name": "page[after]",
                "value": "",
                "type": "query",
                "description": "Request the next page of data, starting with the item after this parameter."
              }
            ]
          },
          "docs": "Returns a list of nodes associated with the specified Event Gateway."
        },
        {
          "info": {
            "name": "Get a Node",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v1/event-gateways/:gatewayId/nodes/:eventGatewayNodeId",
            "params": [
              {
                "name": "gatewayId",
                "value": "",
                "type": "path",
                "description": "The UUID of your Gateway."
              },
              {
                "name": "eventGatewayNodeId",
                "value": "",
                "type": "path",
                "description": "The ID of the Event Gateway Node."
              }
            ]
          },
          "docs": "Returns information about a specific node associated with the Event Gateway."
        },
        {
          "info": {
            "name": "List Node Errors",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v1/event-gateways/:gatewayId/nodes/:eventGatewayNodeId/errors",
            "params": [
              {
                "name": "gatewayId",
                "value": "",
                "type": "path",
                "description": "The UUID of your Gateway."
              },
              {
                "name": "eventGatewayNodeId",
                "value": "",
                "type": "path",
                "description": "The ID of the Event Gateway Node."
              }
            ]
          },
          "docs": "Returns information about the node errors."
        },
        {
          "info": {
            "name": "Get Node Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v1/event-gateways/:gatewayId/nodes/:eventGatewayNodeId/status",
            "params": [
              {
                "name": "gatewayId",
                "value": "",
                "type": "path",
                "description": "The UUID of your Gateway."
              },
              {
                "name": "eventGatewayNodeId",
                "value": "",
                "type": "path",
                "description": "The ID of the Event Gateway Node."
              }
            ]
          },
          "docs": "Returns information about the node status."
        }
      ]
    }
  ],
  "bundled": true
}