      "name": "Workspaces",
      "description": {
        "content": "The workspace object describes the workspace entity, which has an ID and a name.\n<br><br>\nWorkspaces provide a way to segment Kong Gateway entities. Entities in a workspace are isolated from those in other workspaces.\n",
        "type": "text/plain"
      },
