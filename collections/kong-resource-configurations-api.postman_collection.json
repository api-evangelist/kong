          "id": "c5f0e747-2f68-4f43-bba7-f7bda3d52224",
          "name": "List Default Resource Configurations",
          "request": {
            "name": "List Default Resource Configurations",
            "description": {
              "content": "Returns a paginated collection of default resource configurations for cloud-gateways, along with\norganizationally-defined overrides for those resource configurations.\nResource configurations are settings that are applied to all cloud gateway resources in an organization.\nFor example, the \"data-plane-group-idle-timeout-minutes\" resource configuration sets the idle timeout for all data plane groups in an organization.\n",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
