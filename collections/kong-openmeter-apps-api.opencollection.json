{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kong Enterprise Admin ACLs OpenMeter Apps API",
    "version": "3.14.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Kong-Admin-Token",
      "value": "{{Kong-Admin-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "OpenMeter Apps",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List apps",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v3/openmeter/apps",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Determines which page of the collection to retrieve."
              }
            ]
          },
          "docs": "List installed apps."
        },
        {
          "info": {
            "name": "Get app",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v3/openmeter/apps/:appId",
            "params": [
              {
                "name": "appId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get an installed app."
        }
      ]
    }
  ],
  "bundled": true
}