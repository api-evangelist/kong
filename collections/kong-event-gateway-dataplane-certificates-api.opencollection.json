{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kong Enterprise Admin ACLs Event Gateway DataPlane Certificates API",
    "version": "3.14.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Kong-Admin-Token",
      "value": "{{Kong-Admin-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Event Gateway DataPlane Certificates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Event Gateway DataPlane Certificates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v1/event-gateways/:gatewayId/data-plane-certificates",
            "params": [
              {
                "name": "gatewayId",
                "value": "",
                "type": "path",
                "description": "The UUID of your Gateway."
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "The maximum number of items to include per page. The last page of a collection may include fewer items."
              },
              {
                "name": "page[after]",
                "value": "",
                "type": "query",
                "description": "Request the next page of data, starting with the item after this parameter."
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Filter documents returned in the response."
              }
            ]
          },
          "docs": "Returns a list of dataplane certificates that are associated to this event gateway. A dataplane certificate allows dataplanes configured with the certificate and corresponding private key to establish connection with this event gateway."
        },
        {
          "info": {
            "name": "Create a New DataPlane Certificate",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{protocol}://{hostname}:{port}{path}/v1/event-gateways/:gatewayId/data-plane-certificates",
            "params": [
              {
                "name": "gatewayId",
                "value": "",
                "type": "path",
                "description": "The UUID of your Gateway."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create new dataplane certificate to this event gateway. A dataplane certificate allows dataplanes configured with the certificate and corresponding private key to establish connection with this event gateway."
        },
        {
          "info": {
            "name": "Get a DataPlane Certificate",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v1/event-gateways/:gatewayId/data-plane-certificates/:certificateId",
            "params": [
              {
                "name": "gatewayId",
                "value": "",
                "type": "path",
                "description": "The UUID of your Gateway."
              },
              {
                "name": "certificateId",
                "value": "",
                "type": "path",
                "description": "The ID of the dataplane certificate."
              }
            ]
          },
          "docs": "Returns information about an individual dataplane certificate."
        },
        {
          "info": {
            "name": "Update Event Gateway DataPlane Certificate",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{protocol}://{hostname}:{port}{path}/v1/event-gateways/:gatewayId/data-plane-certificates/:certificateId",
            "params": [
              {
                "name": "gatewayId",
                "value": "",
                "type": "path",
                "description": "The UUID of your Gateway."
              },
              {
                "name": "certificateId",
                "value": "",
                "type": "path",
                "description": "The ID of the dataplane certificate."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing dataplane certificate associated with the specified Event Gateway."
        },
        {
          "info": {
            "name": "Delete Event Gateway DataPlane Certificate",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{protocol}://{hostname}:{port}{path}/v1/event-gateways/:gatewayId/data-plane-certificates/:certificateId",
            "params": [
              {
                "name": "gatewayId",
                "value": "",
                "type": "path",
                "description": "The UUID of your Gateway."
              },
              {
                "name": "certificateId",
                "value": "",
                "type": "path",
                "description": "The ID of the dataplane certificate."
              }
            ]
          },
          "docs": "Deletes a specific dataplane certificate associated with the Event Gateway."
        }
      ]
    }
  ],
  "bundled": true
}