{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kong Enterprise Admin ACLs Team Membership API",
    "version": "3.14.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Kong-Admin-Token",
      "value": "{{Kong-Admin-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Team Membership",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Team Users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v3/teams/:teamId/users",
            "params": [
              {
                "name": "teamId",
                "value": "",
                "type": "path",
                "description": "ID of the team."
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "The maximum number of items to include per page. The last page of a collection may include fewer items."
              },
              {
                "name": "page[number]",
                "value": "",
                "type": "query",
                "description": "Determines which page of the entities to retrieve."
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Filter users returned in the response."
              }
            ]
          },
          "docs": "Returns a paginated list of users that belong to the team specified in the path parameter."
        },
        {
          "info": {
            "name": "Add User",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{protocol}://{hostname}:{port}{path}/v3/teams/:teamId/users",
            "params": [
              {
                "name": "teamId",
                "value": "",
                "type": "path",
                "description": "ID of the team."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds a user to a team."
        },
        {
          "info": {
            "name": "Remove User",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{protocol}://{hostname}:{port}{path}/v3/teams/:teamId/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "User ID"
              },
              {
                "name": "teamId",
                "value": "",
                "type": "path",
                "description": "Team ID."
              }
            ]
          },
          "docs": "Removes a user from a team.\nIf the user was removed, returns a 204 empty response. Returns 404 if the user or team were not found."
        },
        {
          "info": {
            "name": "List User Teams",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v3/users/:userId/teams",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The user ID."
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "The maximum number of items to include per page. The last page of a collection may include fewer items."
              },
              {
                "name": "page[number]",
                "value": "",
                "type": "query",
                "description": "Determines which page of the entities to retrieve."
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Filter teams returned in the response."
              }
            ]
          },
          "docs": "Returns a paginated list of a teams that the user belongs to."
        }
      ]
    }
  ],
  "bundled": true
}