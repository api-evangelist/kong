{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kong Enterprise Admin ACLs Event Gateways API",
    "version": "3.14.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Kong-Admin-Token",
      "value": "{{Kong-Admin-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Event Gateways",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all Event Gateways",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v1/event-gateways",
            "params": [
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "The maximum number of items to include per page. The last page of a collection may include fewer items."
              },
              {
                "name": "page[after]",
                "value": "",
                "type": "query",
                "description": "Request the next page of data, starting with the item after this parameter."
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Filter documents returned in the response."
              }
            ]
          },
          "docs": "Returns an array of gateway objects containing information about the Konnect Event Gateways."
        },
        {
          "info": {
            "name": "Create Event Gateway",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{protocol}://{hostname}:{port}{path}/v1/event-gateways",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a Event gateway in the Konnect Organization."
        },
        {
          "info": {
            "name": "Get an Event Gateway",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v1/event-gateways/:gatewayId",
            "params": [
              {
                "name": "gatewayId",
                "value": "",
                "type": "path",
                "description": "The UUID of your Gateway."
              }
            ]
          },
          "docs": "Returns information about an individual Event gateway."
        },
        {
          "info": {
            "name": "Update Event Gateway",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{protocol}://{hostname}:{port}{path}/v1/event-gateways/:gatewayId",
            "params": [
              {
                "name": "gatewayId",
                "value": "",
                "type": "path",
                "description": "The UUID of your Gateway."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an individual gateway."
        },
        {
          "info": {
            "name": "Partially Update Event Gateway",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{protocol}://{hostname}:{port}{path}/v1/event-gateways/:gatewayId",
            "params": [
              {
                "name": "gatewayId",
                "value": "",
                "type": "path",
                "description": "The UUID of your Gateway."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Patch an individual gateway."
        },
        {
          "info": {
            "name": "Delete Event Gateway",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{protocol}://{hostname}:{port}{path}/v1/event-gateways/:gatewayId",
            "params": [
              {
                "name": "gatewayId",
                "value": "",
                "type": "path",
                "description": "The UUID of your Gateway."
              }
            ]
          },
          "docs": "Delete an individual gateway."
        }
      ]
    }
  ],
  "bundled": true
}