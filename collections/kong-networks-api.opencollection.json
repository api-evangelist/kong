{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kong Enterprise Admin ACLs Networks API",
    "version": "3.14.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Kong-Admin-Token",
      "value": "{{Kong-Admin-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Networks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Networks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v2/cloud-gateways/networks",
            "params": [
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Filters supported for networks."
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "The maximum number of items to include per page. The last page of a collection may include fewer items."
              },
              {
                "name": "page[number]",
                "value": "",
                "type": "query",
                "description": "Determines which page of the entities to retrieve."
              }
            ]
          },
          "docs": "Returns a paginated list of networks."
        },
        {
          "info": {
            "name": "Create Network",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{protocol}://{hostname}:{port}{path}/v2/cloud-gateways/networks",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new network for a given provider account."
        },
        {
          "info": {
            "name": "Get Network",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v2/cloud-gateways/networks/:networkId",
            "params": [
              {
                "name": "networkId",
                "value": "",
                "type": "path",
                "description": "The network to operate on."
              }
            ]
          },
          "docs": "Retrieves a network by ID."
        },
        {
          "info": {
            "name": "Update Network",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{protocol}://{hostname}:{port}{path}/v2/cloud-gateways/networks/:networkId",
            "params": [
              {
                "name": "networkId",
                "value": "",
                "type": "path",
                "description": "The network to operate on."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a network by ID."
        },
        {
          "info": {
            "name": "Delete Network",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{protocol}://{hostname}:{port}{path}/v2/cloud-gateways/networks/:networkId",
            "params": [
              {
                "name": "networkId",
                "value": "",
                "type": "path",
                "description": "The network to operate on."
              }
            ]
          },
          "docs": "Deletes a network by ID."
        },
        {
          "info": {
            "name": "List Network Configuration References",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v2/cloud-gateways/networks/:networkId/configuration-references",
            "params": [
              {
                "name": "networkId",
                "value": "",
                "type": "path",
                "description": "The network to operate on."
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "The maximum number of items to include per page. The last page of a collection may include fewer items."
              },
              {
                "name": "page[number]",
                "value": "",
                "type": "query",
                "description": "Determines which page of the entities to retrieve."
              }
            ]
          },
          "docs": "Returns a paginated collection of configurations that reference a network.\n"
        }
      ]
    }
  ],
  "bundled": true
}