  "item": [
    {
      "id": "a85c1446-6cfb-4ef6-bdcd-76fb8fbc35eb",
      "name": "Integration Instance Auth Config",
      "description": {
        "content": "A integration instance may need to be provided with an auth config before authorizing the instance.\nTypically an auth config will be required when authorizing against a integration which is hosted within your organization.\nThe integration instance's auth config will inform how the Service Catalog will authorize the integration instance.\nNote that updating the auth config for an instance which is already authorized will **remove the existing credential**, requiring you to re-authorize the instance.\n",
        "type": "text/plain"
      },
