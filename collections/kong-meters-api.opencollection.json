{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kong Enterprise Admin ACLs Meters API",
    "version": "3.14.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Kong-Admin-Token",
      "value": "{{Kong-Admin-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Meters",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List meters",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v3/openmeter/meters",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Determines which page of the collection to retrieve."
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sort meters returned in the response.\nSupported sort attributes are:\n- `key`\n- `name`\n- `aggregation`\n- `createdAt` (default)\n- `updatedAt`\n\nThe `asc` suffix is optional as the default sort order is ascending.\nThe `desc` suffix is used to specify a descending order."
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Filter meters returned in the response.\n\nTo filter meters by key add the following query param: filter[key]=my-meter-key"
              }
            ]
          },
          "docs": "List meters."
        },
        {
          "info": {
            "name": "Create meter",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{protocol}://{hostname}:{port}{path}/v3/openmeter/meters",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a meter."
        },
        {
          "info": {
            "name": "Get meter",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v3/openmeter/meters/:meterId",
            "params": [
              {
                "name": "meterId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a meter by ID."
        },
        {
          "info": {
            "name": "Delete meter",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{protocol}://{hostname}:{port}{path}/v3/openmeter/meters/:meterId",
            "params": [
              {
                "name": "meterId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a meter."
        }
      ]
    }
  ],
  "bundled": true
}