{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kong Enterprise Admin ACLs Users API",
    "version": "3.14.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Kong-Admin-Token",
      "value": "{{Kong-Admin-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v3/users",
            "params": [
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "The maximum number of items to include per page. The last page of a collection may include fewer items."
              },
              {
                "name": "page[number]",
                "value": "",
                "type": "query",
                "description": "Determines which page of the entities to retrieve."
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Filter users returned in the response."
              }
            ]
          },
          "docs": "Returns a paginated list of user objects."
        },
        {
          "info": {
            "name": "Get a User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v3/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The ID of the user being deleted."
              }
            ]
          },
          "docs": "Returns the user object for the user ID specified as a path parameter."
        },
        {
          "info": {
            "name": "Update User",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{protocol}://{hostname}:{port}{path}/v3/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The ID of the user being deleted."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an individual user."
        },
        {
          "info": {
            "name": "Delete User",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{protocol}://{hostname}:{port}{path}/v3/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The ID of the user being deleted."
              }
            ]
          },
          "docs": "Deletes an individual user. Returns 404 if the requested user was not found."
        }
      ]
    }
  ],
  "bundled": true
}