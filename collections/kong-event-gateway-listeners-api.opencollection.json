                "value": "",
                "type": "path",
                "description": "The UUID of your Gateway."
              },
              {
                "name": "eventGatewayListenerId",
                "value": "",
                "type": "path",
                "description": "The ID of the Event Gateway Listener."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing listener associated with the specified Event Gateway."
        },
        {
          "info": {
            "name": "Delete Event Gateway Listener",
            "type": "http"
