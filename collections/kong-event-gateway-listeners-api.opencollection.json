                "name": "gatewayId",
                "value": "",
                "type": "path",
                "description": "The UUID of your Gateway."
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "The maximum number of items to include per page. The last page of a collection may include fewer items."
              },
              {
                "name": "page[after]",
                "value": "",
                "type": "query",
                "description": "Request the next page of data, starting with the item after this parameter."
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Filter listeners returned in the response."
              }
            ]
          },
          "docs": "Returns a list of listeners associated with the specified Event Gateway."
        },
        {
          "info": {
            "name": "Create Event Gateway Listener",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{protocol}://{hostname}:{port}{path}/v1/event-gateways/:gatewayId/listeners",
