            "name": "Get an Event Gateway Listener",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v1/event-gateways/:gatewayId/listeners/:eventGatewayListenerId",
            "params": [
              {
                "name": "gatewayId",
                "value": "",
                "type": "path",
                "description": "The UUID of your Gateway."
              },
              {
                "name": "eventGatewayListenerId",
                "value": "",
                "type": "path",
                "description": "The ID of the Event Gateway Listener."
              }
            ]
          },
          "docs": "Returns information about a specific listener associated with the Event Gateway."
        },
        {
          "info": {
            "name": "Update Event Gateway Listener",
