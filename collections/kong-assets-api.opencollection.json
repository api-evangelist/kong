{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kong Enterprise Admin ACLs Assets API",
    "version": "3.14.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Kong-Admin-Token",
      "value": "{{Kong-Admin-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Assets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Favicon",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v3/portals/:portalId/assets/favicon",
            "params": [
              {
                "name": "portalId",
                "value": "",
                "type": "path",
                "description": "ID of the portal."
              }
            ]
          },
          "docs": "Returns the favicon of the portal."
        },
        {
          "info": {
            "name": "Replace Favicon",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{protocol}://{hostname}:{port}{path}/v3/portals/:portalId/assets/favicon",
            "params": [
              {
                "name": "portalId",
                "value": "",
                "type": "path",
                "description": "ID of the portal."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Replaces the favicon of the portal. The favicon is used in the browser tab of the portal."
        },
        {
          "info": {
            "name": "Get Favicon (Raw)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v3/portals/:portalId/assets/favicon/raw",
            "params": [
              {
                "name": "portalId",
                "value": "",
                "type": "path",
                "description": "ID of the portal."
              }
            ]
          },
          "docs": "Returns the raw favicon of the portal."
        },
        {
          "info": {
            "name": "Get Logo",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v3/portals/:portalId/assets/logo",
            "params": [
              {
                "name": "portalId",
                "value": "",
                "type": "path",
                "description": "ID of the portal."
              }
            ]
          },
          "docs": "Returns the logo of the portal."
        },
        {
          "info": {
            "name": "Replace Logo",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{protocol}://{hostname}:{port}{path}/v3/portals/:portalId/assets/logo",
            "params": [
              {
                "name": "portalId",
                "value": "",
                "type": "path",
                "description": "ID of the portal."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Replaces the logo of the portal."
        },
        {
          "info": {
            "name": "Get Logo (Raw)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v3/portals/:portalId/assets/logo/raw",
            "params": [
              {
                "name": "portalId",
                "value": "",
                "type": "path",
                "description": "ID of the portal."
              }
            ]
          },
          "docs": "Returns the raw logo of the portal."
        }
      ]
    }
  ],
  "bundled": true
}