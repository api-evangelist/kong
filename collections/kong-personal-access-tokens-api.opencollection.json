{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kong Enterprise Admin ACLs Personal Access Tokens API",
    "version": "3.14.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Kong-Admin-Token",
      "value": "{{Kong-Admin-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Personal Access Tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List PATs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v3/users/:userId/access-tokens",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "ID of the user."
              }
            ]
          },
          "docs": "List personal access tokens for a user."
        },
        {
          "info": {
            "name": "Create a new personal access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{protocol}://{hostname}:{port}{path}/v3/users/:userId/access-tokens",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "ID of the user."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new personal access token. A maximum of 10 personal access tokens can be created."
        },
        {
          "info": {
            "name": "Get Personal Access Token details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v3/users/:userId/access-tokens/:tokenId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "ID of the user."
              },
              {
                "name": "tokenId",
                "value": "",
                "type": "path",
                "description": "ID of the personal access token."
              }
            ]
          },
          "docs": "Get Personal Access Token details."
        },
        {
          "info": {
            "name": "Update personal access token details",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{protocol}://{hostname}:{port}{path}/v3/users/:userId/access-tokens/:tokenId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "ID of the user."
              },
              {
                "name": "tokenId",
                "value": "",
                "type": "path",
                "description": "ID of the personal access token."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update personal access token details."
        },
        {
          "info": {
            "name": "Delete personal access token",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{protocol}://{hostname}:{port}{path}/v3/users/:userId/access-tokens/:tokenId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "ID of the user."
              },
              {
                "name": "tokenId",
                "value": "",
                "type": "path",
                "description": "ID of the personal access token."
              }
            ]
          },
          "docs": "Delete personal access token."
        },
        {
          "info": {
            "name": "Revoke Personal Access Token",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{protocol}://{hostname}:{port}{path}/v3/users/:userId/access-tokens/:tokenId/revoke",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "ID of the user."
              },
              {
                "name": "tokenId",
                "value": "",
                "type": "path",
                "description": "ID of the personal access token."
              }
            ]
          },
          "docs": "Revoke Personal Access Token."
        }
      ]
    }
  ],
  "bundled": true
}