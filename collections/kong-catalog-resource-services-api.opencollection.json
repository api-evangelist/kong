{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kong Enterprise Admin ACLs Catalog Resource Services API",
    "version": "3.14.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Kong-Admin-Token",
      "value": "{{Kong-Admin-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Catalog Resource Services",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Resource Services",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v1/resources/:id/catalog-services",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The `id` of the resource."
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "The maximum number of items to include per page. The last page of a collection may include fewer items."
              },
              {
                "name": "page[number]",
                "value": "",
                "type": "query",
                "description": "Determines which page of the entities to retrieve."
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Filters a collection of services."
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sorts a collection of services. Supported sort attributes are:\n  - `display_name`\n  - `name`\n  - `created_at`\n  - `updated_at`\n\nDefault sort is `display_name` in ascending order.\n"
              }
            ]
          },
          "docs": "Returns a paginated collection of services the given resource is mapped to."
        }
      ]
    }
  ],
  "bundled": true
}