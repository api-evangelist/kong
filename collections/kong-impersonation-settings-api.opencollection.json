{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kong Enterprise Admin ACLs Impersonation Settings API",
    "version": "3.14.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Kong-Admin-Token",
      "value": "{{Kong-Admin-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Impersonation Settings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Impersonation Settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}:{port}{path}/v3/organizations/impersonation"
          },
          "docs": "Returns Impersonation Settings, which determines if user impersonation is allowed for an organization."
        },
        {
          "info": {
            "name": "Update Impersonation Settings",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{protocol}://{hostname}:{port}{path}/v3/organizations/impersonation",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates Impersonation Settings."
        }
      ]
    }
  ],
  "bundled": true
}